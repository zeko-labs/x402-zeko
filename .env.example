# Copy to `.env` for local development. Do not commit real keys.

# Buyer / payer.
X402_EVM_PRIVATE_KEY=replace_with_buyer_private_key
X402_EVM_BUYER_ADDRESS=replace_with_buyer_address

# Relayer / gas payer.
X402_EVM_RELAYER_PRIVATE_KEY=replace_with_relayer_private_key
X402_EVM_RELAYER_ADDRESS=replace_with_relayer_address

# Dedicated receiving wallet for production-style payTo routing.
X402_EVM_PAY_TO_ADDRESS=replace_with_payto_address
X402_EVM_PAY_TO=replace_with_payto_address
X402_BASE_PAY_TO=replace_with_base_payto_address
X402_ETHEREUM_PAY_TO=replace_with_ethereum_payto_address

# Base defaults.
X402_EVM_NETWORK=base
# Hosted facilitators should use a private/dedicated RPC first, with public
# endpoints only as fallbacks. Local experiments may use a public RPC if
# X402_EVM_ALLOW_SHARED_PUBLIC_RPC=true is also set.
X402_BASE_RPC_URL=replace_with_private_base_rpc
X402_BASE_RPC_URLS=https://replace_with_private_base_rpc,https://mainnet.base.org
X402_EVM_AMOUNT=0.01

# Base Sepolia escrow deployment defaults.
X402_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
X402_BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=replace_with_base_sepolia_deployer_private_key
X402_BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_BASE_SEPOLIA_ESCROW_ADMIN=replace_with_escrow_admin_address
X402_BASE_SEPOLIA_ESCROW_RELEASER=replace_with_escrow_releaser_address
X402_BASE_SEPOLIA_TOKEN_ADDRESS=optional_existing_test_token_address
X402_BASE_SEPOLIA_ESCROW_ADDRESS=optional_existing_test_escrow_address
X402_BASE_SEPOLIA_USDC_AMOUNT=0.01

# Ethereum Sepolia escrow deployment defaults.
X402_ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
X402_ETHEREUM_SEPOLIA_DEPLOYER_PRIVATE_KEY=replace_with_ethereum_sepolia_deployer_private_key
X402_ETHEREUM_SEPOLIA_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
X402_ETHEREUM_SEPOLIA_ESCROW_ADMIN=replace_with_ethereum_sepolia_escrow_admin_address
X402_ETHEREUM_SEPOLIA_ESCROW_RELEASER=replace_with_ethereum_sepolia_escrow_releaser_address
X402_ETHEREUM_SEPOLIA_TOKEN_ADDRESS=optional_existing_test_token_address
X402_ETHEREUM_SEPOLIA_ESCROW_ADDRESS=optional_existing_test_escrow_address
X402_ETHEREUM_SEPOLIA_USDC_AMOUNT=0.01

# Optional self-hosted facilitator service.
# For Render or another web host, set HOST to 0.0.0.0 and PORT to the platform port.
X402_EVM_FACILITATOR_HOST=127.0.0.1
X402_EVM_FACILITATOR_PORT=7422

# External relayer lock for hosted multi-replica deployments that share one relayer wallet.
# Leave unset for local runs, one service instance per relayer, or one relayer wallet per instance.
X402_EVM_RELAYER_LOCK_URL=
X402_EVM_RELAYER_LOCK_BEARER_TOKEN=
X402_EVM_RELAYER_LOCK_TTL_MS=600000
X402_EVM_RELAYER_LOCK_RENEW_INTERVAL_MS=60000
X402_EVM_RELAYER_LOCK_ACQUIRE_TIMEOUT_MS=15000
X402_EVM_RELAYER_LOCK_RETRY_DELAY_MS=250
X402_EVM_RELAYER_LOCK_REQUEST_TIMEOUT_MS=5000
# Local experiments only; hosted deployments should leave this unset.
X402_EVM_ALLOW_UNAUTHENTICATED_RELAYER_LOCK=

# Ethereum rail.
X402_ETHEREUM_RPC_URL=https://ethereum.publicnode.com
X402_ETHEREUM_RPC_URLS=https://replace_with_private_ethereum_rpc,https://ethereum.publicnode.com
X402_ETHEREUM_USDC_AMOUNT=0.01

# Emerging custom EVM rails.
# These require a self-hosted or compatible custom facilitator and verified
# EIP-3009 token support before production use.
X402_TEMPO_RPC_URL=replace_with_private_tempo_rpc
X402_TEMPO_RPC_URLS=https://replace_with_private_tempo_rpc
X402_TEMPO_RELAYER_PRIVATE_KEY=replace_with_tempo_relayer_private_key
X402_TEMPO_PAY_TO=replace_with_tempo_payto_address
X402_TEMPO_USDC_AMOUNT=0.01
X402_TEMPO_EIP712_NAME=replace_with_verified_tempo_usdc_eip712_name

# Arc mainnet details should be filled only after official mainnet connection
# and token details are published. The smoke selector supports Arc Testnet.
X402_ARC_RPC_URL=https://rpc.testnet.arc.network/
X402_ARC_RPC_URLS=https://rpc.testnet.arc.network/
X402_ARC_RELAYER_PRIVATE_KEY=replace_with_arc_relayer_private_key
X402_ARC_PAY_TO=replace_with_arc_payto_address
X402_ARC_USDC_AMOUNT=0.01
X402_ARC_EIP712_NAME=replace_with_verified_arc_usdc_eip712_name

# Fully custom EVM EIP-3009 token fallback.
X402_EVM_CHAIN_NAME=replace_with_chain_name
X402_EVM_TOKEN_ADDRESS=replace_with_token_address
X402_EVM_TOKEN_SYMBOL=USDC
X402_EVM_TOKEN_DECIMALS=6
X402_EVM_EIP712_NAME=replace_with_verified_token_eip712_name

# Zeko rail.
# Testnet is the default. Use X402_ZEKO_NETWORK=mainnet for Zeko mainnet.
X402_ZEKO_NETWORK=testnet
# Zeko testnet amounts below are denominated in tMINA. Mainnet amounts are denominated in MINA.
ZEKO_GRAPHQL=https://testnet.zeko.io/graphql
ZEKO_ARCHIVE=https://archive.testnet.zeko.io/graphql
X402_ZKAPP_PUBLIC_KEY=replace_with_zeko_settlement_contract
X402_PAYER_PRIVATE_KEY=replace_with_zeko_payer_private_key

# Zeko mainnet:
# X402_ZEKO_NETWORK=mainnet
# ZEKO_GRAPHQL=https://mainnet.zeko.io/graphql
# ZEKO_ARCHIVE=https://archive.mainnet.zeko.io/graphql
